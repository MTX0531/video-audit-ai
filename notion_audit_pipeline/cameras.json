{
  "_说明": "门店侧抓流配置。本文件由 store_capture.py 读取。每个摄像头一条。门店机只做抓流+切片+上传，不跑AI推理（无需GPU/MLX）。",
  "_大华RTSP格式": "rtsp://<用户名>:<密码>@<摄像头IP>:554/cam/realmonitor?channel=<通道号>&subtype=1  （subtype=1=子码流/低码率分析副本，推荐）",
  "_NVR取流": "若走 NVR 汇聚，channel 填 NVR 的逻辑通道号即可，subtype=1 同样取子码流。",

  "staging_dir": "/Users/<用户名>/WorkBuddy/视频稽核/notion_audit_pipeline/_capture_staging",
  "segment_seconds": 1800,
  "stable_sec": 60,
  "poll_sec": 30,

  "cameras": [
    {
      "store": "<门店1>",
      "camera": "<摄像头1>",
      "rtsp_url": "rtsp://admin:PASSWORD@192.168.2.11:554/cam/realmonitor?channel=1&subtype=1",
      "segment_seconds": 1800,
      "business_hours": ["09:00", "22:00"],
      "ffmpeg_extra": ""
    },
    {
      "store": "<门店2>",
      "camera": "<摄像头2>",
      "rtsp_url": "rtsp://admin:PASSWORD@192.168.2.12:554/cam/realmonitor?channel=2&subtype=1",
      "segment_seconds": 1800,
      "business_hours": ["09:00", "21:00"],
      "ffmpeg_extra": ""
    }
  ]
}
